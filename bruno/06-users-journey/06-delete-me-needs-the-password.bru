meta {
  name: Deleting your account requires the password
  type: http
  seq: 6
}

delete {
  url: {{student_api}}/users/me
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  x-e2e-actor: owner
}

body:json {
  {
    "password": "this-is-not-the-owners-password"
  }
}

assert {
  res.status: eq 401
}

tests {
  test("a valid access token alone cannot delete the account", function () {
    // Re-authentication on a destructive action. The caller here is fully
    // authenticated — the bearer token is real and current — and is still
    // refused, which is the entire point: a stolen token must not be enough to
    // destroy an account.
    //
    // Deliberately sending the WRONG password. The success path would scrub the
    // seeded owner and break every folder after this one, so it belongs in
    // pytest where a transaction rolls back. What is safe, and valuable, to
    // assert over HTTP is the refusal.
    expect(res.getStatus(), "wrong password on DELETE /users/me").to.equal(401);
  });

  test("the account still exists afterwards", async function () {
    // Proves the refusal was total, not partial. A handler that scrubbed fields
    // before checking the password would leave a damaged row behind while still
    // answering 401 — and nothing in the status code would say so.
    const r = await bru.sendRequest({
      method: "GET",
      url: `${bru.getEnvVar("student_api")}/users/me`,
      headers: { Authorization: `Bearer ${bru.getVar("owner_access_token")}` },
    });
    expect(r.status, "the owner must still be readable").to.equal(200);
    expect(r.data.email).to.equal("e2e-owner@example.com");
    expect(r.data.is_active, "and still active").to.be.true;
  });
}

docs {
  Only the refusal path is exercised — see the test comment. The suite must not
  delete the accounts it depends on, and a destructive endpoint's happy path is
  exactly what an in-process test with a rollback is for.
}
