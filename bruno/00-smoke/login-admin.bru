meta {
  name: Start Superadmin login
  type: http
  seq: 5
}

post {
  url: {{admin_api}}/auth/superadmin/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "e2e-admin@example.com",
    "password": "{{e2e_password}}"
  }
}

assert {
  res.status: eq 200
}

tests {
  test("credentials return only an MFA challenge", function () {
    expect(res.getBody().challenge_token).to.be.a("string").and.not.be.empty;
    expect(res.getBody()).not.to.have.property("access_token");
  });

  bru.setVar("e2e_admin_challenge", res.getBody().challenge_token);
}

docs {
  Starts the test-only Superadmin MFA flow. The next request proves TOTP before
  the IAM folder can use this principal.
}
