meta {
  name: A request id is generated when none is sent
  type: http
  seq: 2
}

get {
  url: {{base_url}}/health
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("generates a UUID-shaped id", function () {
    expect(res.getHeader("x-request-id")).to.match(
      /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i
    );
  });
}
