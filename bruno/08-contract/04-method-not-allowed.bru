meta {
  name: A wrong method returns 405
  type: http
  seq: 4
}

delete {
  url: {{base_url}}/health
  body: none
  auth: none
}

assert {
  res.status: eq 405
}

docs {
  /health is GET-only. 405 rather than 404 tells a client the path is real but
  the verb is wrong — a distinction worth keeping.
}
