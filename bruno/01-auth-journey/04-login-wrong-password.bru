meta {
  name: Wrong password is rejected
  type: http
  seq: 4
}

post {
  url: {{api}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "e2e-owner@example.com",
    "password": "definitely-not-the-password"
  }
}

assert {
  res.status: eq 401
}

tests {
  // Captured so the next request can prove the two messages are identical.
  bru.setVar("wrong_password_detail", res.getBody().detail);

  test("does not reveal WHICH credential was wrong", function () {
    // The message names both fields together ("Incorrect email or password"),
    // which is the point: it must not single one out. A message naming only the
    // password would confirm the address is registered.
    const detail = res.getBody().detail.toLowerCase();
    expect(detail, "detail").to.contain("email");
    expect(detail, "detail").to.contain("password");
    expect(detail, "must not confirm the account exists").to.not.contain("exist");
  });
}
