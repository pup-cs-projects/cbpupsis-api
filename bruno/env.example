# The committed shape of bruno/.env. Copy it, do not edit it:
#
#     cp env.example .env
#
# `.env` is gitignored by the repository root's `.env` rule and holds the real
# value; this file is committed and holds none.
#
# Bruno reads this file to resolve the `e2e_password` secret var declared in
# environments/*.bru. It must match the password the accounts were seeded with:
#
#     uv run python -m scripts.seed_e2e
#
# The default below matches seed_e2e.py's own default, so the two work together
# out of the box. Change both together, never one alone.

E2E_PASSWORD=E2ETestPassword123!
