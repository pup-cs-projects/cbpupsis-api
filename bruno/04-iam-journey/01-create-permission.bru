meta {
  name: Create a permission
  type: http
  seq: 1
}

post {
  url: {{admin_api}}/iam/permissions
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  x-e2e-actor: admin
}

body:json {
  {
    "action": "{{e2e_permission}}",
    "description": "Created by the Bruno end-to-end suite."
  }
}

script:pre-request {
  // Unique per run: these records persist, and a fixed name would 409 on the
  // second run. The prefix keeps them identifiable as test residue.
  //
  // The name must satisfy the project's permission vocabulary
  // (Create/Read/Update/Delete<X> for own records), which
  // tests/test_permission_naming.py enforces — hence "ReadE2E...", not
  // "e2e-test-perm".
  const suffix = `${Date.now()}`;
  bru.setVar("e2e_suffix", suffix);
  bru.setVar("e2e_permission", `ReadE2EProbe${suffix}`);
  bru.setVar("e2e_policy", `E2EProbeViewer${suffix}`);
  bru.setVar("e2e_group", `E2EProbes${suffix}`);
}

assert {
  res.status: eq 201
  res.body.action: eq {{e2e_permission}}
}
