meta {
  name: An unknown user cannot be added
  type: http
  seq: 8
}

post {
  url: {{api}}/iam/groups/{{e2e_group_id}}/users
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  x-e2e-actor: admin
}

body:json {
  {
    "user_id": "00000000-0000-0000-0000-000000000000"
  }
}

tests {
  test("is refused rather than silently accepted", function () {
    expect(res.getStatus(), "expected a 4xx").to.be.within(400, 499);
  });
}
