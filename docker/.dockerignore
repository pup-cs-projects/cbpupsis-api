# Build context is the PROJECT ROOT (docker build -f docker/Dockerfile.prod .),
# so this file must live here, not in docker/.
#
# Everything excluded below either bloats the image, breaks it, or must never
# ship. The .venv line is the important one: the host venv is built for the
# host's platform, and copying it over the container's would produce a broken
# interpreter path.

# Local virtualenv — the image builds its own.
.venv/
venv/

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Secrets never enter an image: compose passes env/env.<env> in at RUN time, so
# baking it into a layer would both leak it and freeze it.
env/
.env
.env.*

# VCS and CI
.git/
.gitignore
.github/

# Tests and docs are not needed at runtime; the prod image excludes dev deps
# anyway, so a test file in the image could not run.
tests/
docs/
*.md

# Docker's own files
docker/
docker-compose*.yml
.dockerignore

# Editor and OS noise
.vscode/
.idea/
.DS_Store
