# syntax=docker/dockerfile:1
#
# Staging image for the admin app. Identical build to docker/admin/Dockerfile.prod
# (same stages, same --no-dev, same non-root user) because staging only tells
# you something if it is the artifact you intend to ship.
#
# The admin image also carries the migrations and scripts/: compose runs the
# one-shot `migrate` service, the outbox worker, and the seed scripts from it,
# since each is an administrative operation over the shared database.
#
# What differs is CONFIGURATION, injected at runtime, not baked here:
#   ENVIRONMENT=staging   keeps API docs closed (the gate is development-only)
#   LOG_LEVEL=DEBUG       more detail than production, since nobody is paged
#   LOG_JSON=true         same structured logs as production
#
# The one build-time difference is the label, so an image in a registry can be
# traced back to the pipeline that produced it.
#
# Build from the PROJECT ROOT:
#   docker build -f docker/admin/Dockerfile.staging -t api-admin:staging .
#
# If you find yourself adding anything else here, ask whether it belongs in
# configuration instead. A staging image that differs from production is a
# staging environment that cannot vouch for a release.

# ---------- build stage ----------
FROM python:3.12-slim AS build

COPY --from=ghcr.io/astral-sh/uv:0.9.9 /uv /uvx /bin/

WORKDIR /app

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

COPY pyproject.toml uv.lock ./
# Two syncs: the app, then Alembic on top (--inexact keeps the first set).
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-workspace --no-dev --package cbpupsis-api-admin && \
    uv sync --frozen --no-install-workspace --no-dev --inexact --package cbpupsis-migrations

COPY packages/core ./packages/core
COPY packages/database ./packages/database
COPY packages/shared ./packages/shared
COPY packages/migrations ./packages/migrations
COPY apps/api-admin ./apps/api-admin
COPY scripts ./scripts
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --inexact --package cbpupsis-api-admin && \
    uv sync --frozen --no-dev --inexact --package cbpupsis-migrations

# ---------- runtime stage ----------
FROM python:3.12-slim AS runtime

ARG GIT_SHA=unknown
LABEL org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.title="api-admin" \
      env="staging"

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    ALEMBIC_CONFIG=/app/packages/migrations/alembic.ini

RUN groupadd -g 1001 appgroup && \
    useradd -u 1001 -g appgroup -m -d /app -s /bin/false appuser

WORKDIR /app

COPY --from=build --chown=appuser:appgroup /app /app

USER appuser

EXPOSE 8003

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:8003/health', timeout=2).status == 200 else 1)"

CMD ["uvicorn", "cbpupsis_api_admin.main:app", \
     "--host", "0.0.0.0", "--port", "8003", \
     "--proxy-headers", "--forwarded-allow-ips", "*"]
