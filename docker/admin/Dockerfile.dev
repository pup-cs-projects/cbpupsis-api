# syntax=docker/dockerfile:1
#
# Development image for the admin app: optimised for the edit-reload loop, not
# for shipping. Contains only this app and the kernel packages it depends on.
#
# The admin image also carries the migrations and scripts/: compose runs the
# one-shot `migrate` service, the outbox worker, and the seed scripts from it,
# since each is an administrative operation over the shared database.
#
# Differences from the production image, all deliberate:
#   - source is bind-mounted at runtime by compose, so an edit is live at once
#   - --reload watches for changes
#   - runs as root, because a bind-mounted volume from the host would otherwise
#     hit uid mismatches on every write
#
# Never deploy this. Use docker/admin/Dockerfile.prod.

FROM python:3.12-slim AS dev

COPY --from=ghcr.io/astral-sh/uv:0.9.9 /uv /uvx /bin/

WORKDIR /app

# UV_LINK_MODE=copy keeps the venv self-contained; UV_PROJECT_ENVIRONMENT puts it
# outside /app so a bind mount over /app cannot shadow the installed packages,
# the most common way a dev container ends up with "module not found".
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    ALEMBIC_CONFIG=/app/packages/migrations/alembic.ini

# Third-party dependencies install from the lockfile alone, so a code edit does
# not invalidate this layer. --frozen reads uv.lock as written: the workspace
# members are not in the image yet, so it cannot be checked against them.
COPY pyproject.toml uv.lock ./
# Two syncs: the app, then Alembic on top (--inexact keeps the first set).
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-workspace --package cbpupsis-api-admin && \
    uv sync --frozen --no-install-workspace --inexact --package cbpupsis-migrations

# Workspace members install as editable links into /app, which compose then
# bind-mounts with the live source.
COPY packages/core ./packages/core
COPY packages/database ./packages/database
COPY packages/shared ./packages/shared
COPY packages/migrations ./packages/migrations
COPY apps/api-admin ./apps/api-admin
COPY scripts ./scripts
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --inexact --package cbpupsis-api-admin && \
    uv sync --frozen --inexact --package cbpupsis-migrations

EXPOSE 8003

# --reload-dir limits the watcher to the code this app runs: watching the whole
# tree picks up .venv and __pycache__ and restarts on files nobody edited.
CMD ["uvicorn", "cbpupsis_api_admin.main:app", \
     "--host", "0.0.0.0", "--port", "8003", \
     "--reload", "--reload-dir", "packages", "--reload-dir", "apps/api-admin"]
