# syntax=docker/dockerfile:1
#
# Production image for the admin app. Multi-stage: dependencies resolve in a
# build stage, and only the application plus its virtualenv reach the runtime
# stage: no uv, no build tools, no caches. Contains only this app and the
# kernel packages it depends on.
#
# The admin image also carries the migrations and scripts/: compose runs the
# one-shot `migrate` service, the outbox worker, and the seed scripts from it,
# since each is an administrative operation over the shared database.
#
# Build from the PROJECT ROOT, not from docker/:
#   docker build -f docker/admin/Dockerfile.prod -t api-admin .

# ---------- build stage ----------
FROM python:3.12-slim AS build

# Pin the uv version: an unpinned tool version makes builds unreproducible.
COPY --from=ghcr.io/astral-sh/uv:0.9.9 /uv /uvx /bin/

WORKDIR /app

# UV_COMPILE_BYTECODE precompiles .pyc for faster cold starts.
# UV_LINK_MODE=copy keeps the venv self-contained so it survives being COPYed
# into the runtime stage, where symlinks would dangle and fail at import time.
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

# Dependencies first, from the lockfile only, so editing source does not bust
# this layer. --no-dev excludes pytest/ruff; --frozen installs exactly what
# uv.lock records, which is what was tested.
COPY pyproject.toml uv.lock ./
# Two syncs: the app, then Alembic on top (--inexact keeps the first set).
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-workspace --no-dev --package cbpupsis-api-admin && \
    uv sync --frozen --no-install-workspace --no-dev --inexact --package cbpupsis-migrations

COPY packages/core ./packages/core
COPY packages/database ./packages/database
COPY packages/shared ./packages/shared
COPY packages/migrations ./packages/migrations
COPY apps/api-admin ./apps/api-admin
COPY scripts ./scripts
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --inexact --package cbpupsis-api-admin && \
    uv sync --frozen --no-dev --inexact --package cbpupsis-migrations

# ---------- runtime stage ----------
FROM python:3.12-slim AS runtime

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    ALEMBIC_CONFIG=/app/packages/migrations/alembic.ini

# Non-root. A container escape from a root process is a host compromise.
RUN groupadd -g 1001 appgroup && \
    useradd -u 1001 -g appgroup -m -d /app -s /bin/false appuser

WORKDIR /app

COPY --from=build --chown=appuser:appgroup /app /app

USER appuser

EXPOSE 8003

# Hits /health, which is deliberately dependency-free: a check that queried
# Postgres would get a healthy container killed whenever the database was
# briefly slow.
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:8003/health', timeout=2).status == 200 else 1)"

# Secrets are injected at runtime (task secrets, env), never baked into a layer:
# anyone who can pull the image can read every layer.
#
# --proxy-headers so client IPs and scheme survive a load balancer in front.
# No --workers: let the orchestrator scale by running more containers, which
# gives you independent health checks and rolling restarts per instance.
CMD ["uvicorn", "cbpupsis_api_admin.main:app", \
     "--host", "0.0.0.0", "--port", "8003", \
     "--proxy-headers", "--forwarded-allow-ips", "*"]
