# syntax=docker/dockerfile:1
#
# Production image. Multi-stage: dependencies resolve in a build stage, and only
# the application plus its virtualenv reach the runtime stage — no uv, no build
# tools, no caches.
#
# Build from the PROJECT ROOT, not from docker/:
#   docker build -f docker/Dockerfile.prod -t api .

# ---------- build stage ----------
FROM python:3.12-slim AS build

# Pin the uv version: an unpinned tool version makes builds unreproducible.
COPY --from=ghcr.io/astral-sh/uv:0.9.9 /uv /uvx /bin/

WORKDIR /app

# UV_COMPILE_BYTECODE precompiles .pyc for faster cold starts.
# UV_LINK_MODE=copy keeps the venv self-contained so it survives being COPYed
# into the runtime stage — symlinks would dangle and fail at import time.
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

# Dependencies first, from lockfiles only, so editing source does not bust this
# layer. --no-dev excludes pytest/ruff; --frozen fails if uv.lock is stale
# rather than silently resolving something different from what was tested.
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --no-dev

COPY . .
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev

# ---------- runtime stage ----------
FROM python:3.12-slim AS runtime

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Non-root. A container escape from a root process is a host compromise.
RUN groupadd -g 1001 appgroup && \
    useradd -u 1001 -g appgroup -m -d /app -s /bin/false appuser

WORKDIR /app

COPY --from=build --chown=appuser:appgroup /app /app

USER appuser

EXPOSE 8000

# Hits /health, which is deliberately dependency-free: a check that queried
# Postgres would get a healthy container killed whenever the database was
# briefly slow.
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:8000/health', timeout=2).status == 200 else 1)"

# Secrets are injected at runtime (task secrets, env), never baked into a layer —
# anyone who can pull the image can read every layer.
#
# --proxy-headers so client IPs and scheme survive a load balancer in front.
# No --workers: let the orchestrator scale by running more containers, which
# gives you independent health checks and rolling restarts per instance.
CMD ["uvicorn", "app.main:app", \
     "--host", "0.0.0.0", "--port", "8000", \
     "--proxy-headers", "--forwarded-allow-ips", "*"]
