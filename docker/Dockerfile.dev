# syntax=docker/dockerfile:1
#
# Development image: optimised for the edit-reload loop, not for shipping.
#
# Differences from the production image, all deliberate:
#   - dev dependencies included (pytest, ruff) so the suite runs in the container
#   - source is bind-mounted at runtime, not COPYed, so an edit is live immediately
#   - --reload watches for changes
#   - runs as root, because a bind-mounted volume from the host would otherwise
#     hit uid mismatches on every write
#
# Never deploy this. Use Dockerfile.prod.

FROM python:3.12-slim AS dev

COPY --from=ghcr.io/astral-sh/uv:0.9.9 /uv /uvx /bin/

WORKDIR /app

# UV_LINK_MODE=copy keeps the venv self-contained; UV_PROJECT_ENVIRONMENT puts it
# outside /app so a bind mount over /app cannot shadow the installed packages —
# the most common way a dev container ends up with "module not found".
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1

# Install from lockfiles only, so a code edit does not invalidate this layer.
# Dev group included: the point of this image is running tests and linters too.
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project

# A copy for the case where nothing is mounted; compose overlays it with the
# real source, so this is a fallback rather than the source of truth.
COPY . .

EXPOSE 8000

# --reload-dir limits the watcher to app code: watching the whole tree picks up
# .venv and __pycache__ and burns CPU restarting on files nobody edited.
CMD ["uvicorn", "app.main:app", \
     "--host", "0.0.0.0", "--port", "8000", \
     "--reload", "--reload-dir", "app"]
