# The committed shape of env/<app>/env.<stage>, one file per app (student,
# faculty, admin). Copy it, do not edit it:
#
#     mkdir -p env/student env/faculty env/admin
#     cp env.example env/student/env.dev
#     cp env.example env/faculty/env.dev
#     cp env.example env/admin/env.dev
#
# DATABASE_URL, DIRECT_DATABASE_URL, and JWT_SECRET must be identical in all
# three: the apps share one database, and each verifies the others' tokens.
#
# env/ is gitignored and holds REAL values; this file is committed and holds
# none. `make up env=dev` reads env/<app>/env.dev, `env=staging` reads
# env/<app>/env.staging.

APP_NAME="CBPUPSIS API"
ENVIRONMENT=development          # development | staging | production
DEBUG=true

# Browser origins allowed to call this API (JSON array).
CORS_ORIGINS=["http://localhost:3000"]

# --- Logging ---
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
# true in deployed environments: log aggregators query JSON fields, not prose.
LOG_JSON=false

# --- Database (Neon) ---
# POOLED connection (host contains -pooler) — used by the app.
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
# DIRECT connection (no -pooler) — used by Alembic migrations. Neon's PgBouncer
# runs in transaction mode, so the connection goes back to the pool after every
# transaction and session state is lost: SET, session advisory locks, and temp
# tables do not survive. Alembic needs them. The app itself is fine on the
# pooled URL — protocol-level prepared statements ARE supported there.
DIRECT_DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# --- Connection pool ---
# The arithmetic that matters, because the pool is PER WORKER PROCESS:
#
#     workers x (DB_POOL_SIZE + DB_MAX_OVERFLOW)  <=  the ceiling below
#
# With the defaults below and 4 uvicorn workers that is 4 x (5 + 10) = 60
# connections at peak. Exceed the ceiling and the extra workers fail at connect
# time under load — that is, precisely when they are needed.
#
# WHICH ceiling depends on which URL you point at. On Neon there are three, and
# they are not interchangeable:
#
#   max_client_conn    10,000  — connections PgBouncer will ACCEPT. Generous;
#                                not the one you run out of first.
#   default_pool_size  90% of max_connections, PER USER PER DATABASE — the real
#                                ceiling when using the POOLED (-pooler) URL.
#   max_connections    varies by compute size — the ceiling on a DIRECT
#                                connection. Neon reserves 7 for its superuser.
#
# So on a 0.25 CU compute: 104 max_connections, 97 left after the reserved 7,
# and ~93 through the pooler. With the defaults below that is 6 workers before
# you are at the edge. A plain Postgres defaults to 100, of which superuser
# slots and your own psql sessions are already spoken for.
#
# Size DB_POOL_SIZE for the steady state and DB_MAX_OVERFLOW for the burst
# above it: overflow connections are opened on demand and closed when returned,
# so they cost a connect round trip but do not sit idle holding a slot.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# Retire a connection after this many seconds, so it is replaced on your terms
# rather than dying silently in a proxy, load balancer, or Neon idle timeout.
# Keep it comfortably BELOW any such idle timeout on the path to the database.
DB_POOL_RECYCLE_SECONDS=1800

# --- Authentication ---
# Signing key for JWTs. Must be >= 32 chars; the app refuses to start otherwise.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-generated-secret-at-least-32-chars-long
# Optional dedicated secret used to derive the AES-256-GCM key for MFA data.
# If omitted, the API derives a purpose-separated sub-key from JWT_SECRET.
# MFA_ENCRYPTION_KEY=replace-me-with-an-independent-high-entropy-secret
WEBAUTHN_RP_ID=admin.cbpupsis
WEBAUTHN_ORIGIN=https://admin.cbpupsis
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- One-time tokens (email verification, password reset) ---
EMAIL_VERIFICATION_TTL_HOURS=24
# Short on purpose: a reset link is a live credential while it lasts.
PASSWORD_RESET_TTL_MINUTES=30

# --- Outbox (durable side effects) ---
# The worker is woken by LISTEN/NOTIFY; this interval is a FLOOR, not the
# primary trigger. It is also the liveness check on the listener: a LISTEN
# connection dropped by a firewall never fires, so an unbounded wait would block
# forever while the worker looked healthy. Short values are expensive against a
# remote database — an empty claim query measured ~47ms against Neon, so a
# 1-second interval is ~68 minutes of database time per day doing nothing.
OUTBOX_POLL_INTERVAL_SECONDS=30
OUTBOX_BATCH_SIZE=50
# Attempts before a message is dead-lettered. With the backoff below that is
# roughly a day of retries: long enough to ride out an SES outage, short enough
# that a poison message stops burning attempts.
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_BACKOFF_BASE_SECONDS=30
OUTBOX_BACKOFF_CAP_SECONDS=3600

# --- Retention (scripts.prune_retention) ---
# Run this on a schedule or the outbox keeps every message it ever delivered and
# becomes the largest table in the database.
#
# DELIVERY_RECEIPT_RETENTION_DAYS must stay LARGER than both outbox windows: a
# receipt is what stops a redelivered message being sent twice, so pruning one
# while its message can still be retried re-opens the duplicate-send window.
OUTBOX_DISPATCHED_RETENTION_DAYS=7
OUTBOX_FAILED_RETENTION_DAYS=30
DELIVERY_RECEIPT_RETENTION_DAYS=60
# Unread notifications are never pruned, whatever this is set to.
NOTIFICATION_READ_RETENTION_DAYS=90
# Bounded so a DELETE cannot take a long-lived lock on the very table that grew
# large enough to need pruning.
RETENTION_BATCH_SIZE=5000

# --- Rate limiting ---
# Master switch. Leave on; the test suite turns it off so a shared limiter
# cannot make tests order-dependent.
RATE_LIMIT_ENABLED=true
# Where the counters live. "memory://" keeps them in the process, which means
# the limit is enforced PER REPLICA: with N replicas a caller effectively gets
# N times the allowance, and counters reset on every deploy. Fine for a single
# instance and for local development. A multi-replica deployment that needs the
# limit to be global must point this at shared storage instead:
#   RATE_LIMIT_STORAGE_URI=redis://redis:6379/0
# The `redis` client ships as a dependency for exactly this: `limits` resolves
# the backend from this URI at startup and raises rather than falling back, so
# a typo here is a boot failure, not a silently unlimited API.
# docker/docker-compose.staging.yml wires up a Redis and sets this.
RATE_LIMIT_STORAGE_URI=memory://
# Per-endpoint limits ("5/minute", "100/hour"). The two that send mail on
# demand are strictest: each request spends money and puts a message in someone
# else's inbox.
RATE_LIMIT_RESEND_VERIFICATION=3/hour
RATE_LIMIT_FORGOT_PASSWORD=3/hour
# Credential stuffing, not a forgetful human, is the threat on login.
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=5/hour

# --- Email (AWS SES) ---
# Leave SES_FROM_EMAIL unset to use the console backend, which logs messages
# instead of sending them. Development and tests then need no AWS credentials
# and cannot email a real person by accident.
AWS_REGION=ap-southeast-1
# A verified SES identity. Setting this switches on real delivery.
# SES_FROM_EMAIL=no-reply@yourdomain.com
# Optional SES configuration set, for bounce/complaint event publishing.
# SES_CONFIGURATION_SET=
# Base URL of the frontend hosting the verify-email and reset-password pages;
# emailed links point here, because a human clicks them.
FRONTEND_BASE_URL=http://localhost:3000
